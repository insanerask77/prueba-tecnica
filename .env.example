# Example environment variables for local development.
# Copy this file to .env and set the variables as needed.

# This variable tells docker-compose which image tag to use for the web service.
# For local development, you can build a local image and set this variable.
# Example:
# 1. Build the image: docker build -t my-random-app:local .
# 2. Set in .env: WEB_IMAGE_TAG=my-random-app:local
# 3. Run: docker-compose up
WEB_IMAGE_TAG=random-error-app:latest
